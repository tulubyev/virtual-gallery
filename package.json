{
  "name": "virtual-art-gallery",
  "version": "1.0.0",
  "description": "A virtual art gallery with VR support, AI curation, and IoT integration",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node src/server.ts",
    "dev:client": "npm --prefix src/frontend run dev",
    "build": "tsc && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm --prefix src/frontend run build",
    "init-db": "ts-node src/database/init.ts",
    "init-s3": "node scripts/initS3Bucket.js"
  },
  "keywords": [
    "virtual-reality",
    "art-gallery",
    "ai",
    "iot"
  ],
  "author": "Virtual Art Gallery Team",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.10.2",
    "adm-zip": "^0.5.16",
    "aws-sdk": "^2.1693.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}

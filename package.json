{
  "name": "virtual-art-gallery",
  "version": "1.0.0",
  "description": "A virtual art gallery with VR support, AI curation, and IoT integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "vite --config vite.config.ts",
    "build": "npx tailwindcss -i src/frontend/assets/css/tailwind-input.css -o src/frontend/assets/css/tailwind-output.css --minify && npx vite build --config vite.config.ts",
    "build:server": "echo 'No TypeScript compilation needed'",
    "build:react": "vite build --config vite.config.ts",
    "build:client": "npm run build:react",
    "init-db": "ts-node src/database/init.ts",
    "init-s3": "node scripts/initS3Bucket.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:tailwind": "tailwindcss -c src/frontend/tailwind.config.js -i src/frontend/assets/css/tailwind-input.css -o src/frontend/assets/css/tailwind-output.css --minify",
    "watch:tailwind": "tailwindcss -c src/frontend/tailwind.config.js -i src/frontend/assets/css/tailwind-input.css -o src/frontend/assets/css/tailwind-output.css --watch"
  },
  "keywords": [
    "virtual-reality",
    "art-gallery",
    "ai",
    "iot"
  ],
  "author": "Virtual Art Gallery Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.24",
    "aws-sdk": "^2.1693.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.563.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redis": "^4.6.10",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/aws-sdk": "^0.0.42",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.16.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^1.7.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  }
}

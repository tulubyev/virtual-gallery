{
  "name": "virtual-art-gallery",
  "version": "1.0.0",
  "description": "A virtual art gallery with VR support, AI curation, and IoT integration",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "init-db": "ts-node src/database/init.ts"
  },
  "keywords": [
    "virtual-reality",
    "art-gallery",
    "ai",
    "iot"
  ],
  "author": "Virtual Art Gallery Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "redis": "^4.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.10.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.1"
  }
}
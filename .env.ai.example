# Настройки Python-ядра ИИ для docker-compose.prod.yml (профиль ai). Копия: cp .env.ai.example .env.ai; chmod 600 .env.ai
# Файл читает только контейнер ядра (virtgal-ai-core); контейнер приложения этих секретов не видит.
# INTERNAL_API_TOKEN здесь не нужен — он общий с приложением и берётся из .env.
# Значения без пробелов и кавычек (формат env_file Docker).

# БД ядра — отдельная virtgal_ai в системном PostgreSQL хоста (создание — docs/DEPLOY.md, «Python-ядро ИИ»).
# Пароль без спецсимволов или URL-кодированный. Миграции применяются автоматически при старте контейнера.
DATABASE_URL=postgresql://virtgal_ai:CHANGE_ME@172.28.0.1:5432/virtgal_ai

# Ключ routerai.ru (личный кабинет) и режим отправки: global — любые модели, ru-only — только серверы в РФ
LLM_API_KEY=
LLM_MODE=global
# Закрепить провайдера (например anthropic для Claude 5.5 — иначе возможен провайдер без строгой JSON-схемы)
LLM_PROVIDER_ONLY=
# flex — режим примерно вдвое дешевле для фоновых задач (Google, OpenAI); пусто — обычный
LLM_BACKGROUND_TIER=

# Домены, с которых ядро вправе скачивать файлы по ссылкам из запросов (кроме хоста S3), через запятую
FETCH_ALLOWED_HOSTS=virtgal.ru,cdn.virtgal.ru

# S3 (те же ключи и бакет, что у приложения): ядро хранит оборот работ приватно и выдаёт короткие подписанные ссылки
S3_ENDPOINT=https://s3.beget.com
S3_REGION=ru-msk
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

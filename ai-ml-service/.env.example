# AI/ML Service Environment Variables

# ===========================================
# SERVICE CONFIGURATION
# ===========================================

# Service environment
NODE_ENV=development
ENVIRONMENT=development

# API Gateway (Node.js)
PORT=8000
API_BASE_URL=http://localhost:8000

# AI Core (Python)
AI_CORE_PORT=8001
AI_CORE_URL=http://localhost:8001

# Внутренний токен ядра (не короче 16 символов): `openssl rand -hex 32`. Такое же значение должно быть в .env основного приложения.
INTERNAL_API_TOKEN=

# Домены, с которых ядро может скачивать изображения и PDF по URL из запросов (через запятую; хост S3 разрешён всегда).
# Для виртуальной галереи: virtgal.ru,cdn.virtgal.ru
FETCH_ALLOWED_HOSTS=

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL (beget.com)
DATABASE_URL=postgresql://tulubyev:CHANGE_ME@your-db-host:5432/aimlservice_db
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=aimlservice_db
DB_USER=tulubyev
DB_PASSWORD=CHANGE_ME

# Vector Database (choose one)
# Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# PostgreSQL + pgvector (alternative)
PGVECTOR_CONNECTION_STRING=postgresql://ai_ml_user:ai_ml_password@localhost:5433/ai_ml_db

# Redis
REDIS_URL=redis://localhost:6379

# ===========================================
# EXTERNAL API KEYS
# ===========================================

# LLM/VLM и эмбеддинги — любой OpenAI-совместимый API; по умолчанию агрегатор routerai.ru
# (ключ создаётся в личном кабинете: routerai.ru → Настройки → API-ключи; хранить только здесь, в git не попадает)
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
# global — любые модели каталога; ru-only — только модели с серверами в РФ (приватные коллекции, данные с ПДн)
LLM_MODE=global
# Закрепить провайдеров через запятую (поле tag из /api/v1/models/<id>/endpoints), иначе балансировщик может сменить страну
LLM_PROVIDER_ONLY=
# flex — режим дешевле примерно вдвое для фоновых задач (необязательно)
LLM_BACKGROUND_TIER=

# Google Cloud Vision (optional)
GOOGLE_VISION_API_KEY=your-google-vision-key
GOOGLE_CLOUD_PROJECT=your-gcp-project

# AWS Rekognition (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ===========================================
# SECURITY
# ===========================================

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# API Keys
API_KEY_SALT=your-api-key-salt

# Webhook secrets
WEBHOOK_SECRET=default_webhook_secret_change_in_prod

# ===========================================
# STORAGE
# ===========================================

# AWS S3 (if using AWS)
S3_BUCKET_NAME=your-gallery-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Local storage (for development)
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# ===========================================
# TASK PROCESSING
# ===========================================

# Queue settings
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300000  # 5 minutes in ms

# Batch processing
BATCH_SIZE=10
BATCH_TIMEOUT=60000  # 1 minute

# ===========================================
# AI/ML MODEL CONFIGURATION
# ===========================================

# Модели по задачам (id из каталога routerai.ru; значения по умолчанию предварительные — окончательный выбор по tools/model_bakeoff.py)
MODEL_VISION_FRONT=anthropic/claude-sonnet-5.5
MODEL_VISION_BACK=anthropic/claude-sonnet-5.5
MODEL_RAG_ANSWER=anthropic/claude-haiku-5.5
MODEL_CHAT=anthropic/claude-haiku-5.5
MODEL_JUDGE=anthropic/claude-haiku-5.5
MODEL_BULK=anthropic/claude-haiku-5.5
# Режим ru-only
MODEL_RU_ONLY_TEXT=sber/gigachat-3-pro
MODEL_RU_ONLY_VISION=qwen/qwen3.6-35b-a3b

# Эмбеддинги текста: bge-m3 даёт 1024 измерения (при смене модели размерность и коллекция Qdrant меняются вместе)
DEFAULT_EMBEDDING_MODEL=baai/bge-m3
VECTOR_DIMENSION=1024

IMAGE_MAX_SIZE=2048  # pixels
MAX_TOKENS=1000

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================

# Main application URLs
MAIN_APP_URL=https://main-app.gallery.com
MAIN_APP_WEBHOOK_URL=https://main-app.gallery.com/webhooks/ai-results

# n8n
N8N_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ===========================================
# DEVELOPMENT
# ===========================================

# Debug mode
DEBUG=true

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# PRODUCTION OVERRIDES
# ===========================================

# In production, override these with actual values:
# - Use strong, unique secrets
# - Configure proper CORS origins
# - Set up monitoring and alerting
# - Configure backup strategies
# - Set up proper SSL/TLS
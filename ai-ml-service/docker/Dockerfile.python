# Python-ядро ИИ (FastAPI). Сборка из каталога ai-ml-service:
#   docker build -f docker/Dockerfile.python -t virtgal-ai-core ai-ml-service
# Python 3.12 — версия, на которой закреплены и проверены зависимости (requirements.txt, CI).
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8001

# Системные пакеты: Tesseract (русский и английский) и poppler — OCR отсканированных PDF; шрифт — видимая метка на изображении
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-rus \
        poppler-utils \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Зависимости отдельным слоем: он пересобирается только при изменении requirements.txt
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY src/ ./src/
COPY migrations/ ./migrations/
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# Не root; временные файлы ядра — в /tmp, загруженные PDF до обработки — в /var/spool/vg (в проде это том)
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin aicore \
    && chmod 0755 /usr/local/bin/entrypoint.sh \
    && mkdir -p /var/spool/vg && chown aicore /var/spool/vg
USER aicore

EXPOSE 8001

# Живость и готовность: /health/ отвечает 200, только если доступны БД, Qdrant и Redis
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import os, sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/health/' % os.environ.get('PORT', '8001'), timeout=8).status == 200 else 1)"]

ENTRYPOINT ["entrypoint.sh"]
# Один процесс: очередь задач (JobWorker) работает внутри него; несколько процессов — несколько воркеров с общей очередью в БД
CMD ["python", "-m", "uvicorn", "src.models.main:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]

# Сервер
PORT=5000
# Только для разработки; в Docker задаётся как production
# NODE_ENV=development

# PostgreSQL. На VPS — системный PostgreSQL 16, из Docker он доступен по 172.28.0.1
# Спецсимволы в пароле URL-кодируются (например, ! → %21)
DB_STRING=postgres://USER:PASSWORD@172.28.0.1:5432/virtual_gallery_db
DB_HOST=172.28.0.1
DB_PORT=5432
DB_NAME=virtual_gallery_db
DB_USER=
DB_PASSWORD=
# true — только для внешних БД с SSL (на VPS не нужно)
DB_SSL=false

# Аутентификация. В production сервер не стартует, если секрет короче 32 символов.
# Сгенерировать: openssl rand -hex 48
JWT_SECRET=
SESSION_SECRET=
WATERMARK_SECRET=

# S3-совместимое хранилище (Beget)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-msk
S3_BUCKET_NAME=
S3_ENDPOINT=https://s3.beget.com

# AI/ML-сервис (Python). Без него приложение работает в демо-режиме.
AI_CORE_URL=http://localhost:8001

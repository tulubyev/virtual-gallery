# Сервер
PORT=5000
# Только для разработки; в Docker задаётся как production
# NODE_ENV=development

# PostgreSQL. На VPS — системный PostgreSQL 16, из Docker он доступен по 172.28.0.1
# Спецсимволы в пароле URL-кодируются (например, ! → %21)
DB_STRING=postgres://USER:PASSWORD@172.28.0.1:5432/virtual_gallery_db
DB_HOST=172.28.0.1
DB_PORT=5432
DB_NAME=virtual_gallery_db
DB_USER=
DB_PASSWORD=
# true — только для внешних БД с SSL (на VPS не нужно)
DB_SSL=false

# Аутентификация. В production сервер не стартует, если секрет короче 32 символов.
# Сгенерировать: openssl rand -hex 48
JWT_SECRET=
SESSION_SECRET=
WATERMARK_SECRET=

# S3-совместимое хранилище (Beget)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-msk
S3_BUCKET_NAME=
S3_ENDPOINT=https://s3.beget.com
# Срок подписанной ссылки на приватный объект, секунды (по умолчанию 300, не более 900); тот же параметр читает ядро ИИ
# S3_PRESIGN_TTL=300

# AI/ML-сервис (Python). Без него приложение работает в демо-режиме.
# На VPS при запуске с профилем ai: AI_CORE_URL=http://virtgal-ai-core:8001; остальные настройки ядра — в .env.ai (.env.ai.example)
AI_CORE_URL=http://localhost:8001
# Общий секрет с Python-ядром (не короче 16 символов): `openssl rand -hex 32`. Передаётся в заголовке X-Internal-Token.
INTERNAL_API_TOKEN=

# Бюджет платных ИИ-запросов (src/middleware/aiBudget.ts); необязательно, ниже — значения по умолчанию, 0 — без ограничения.
# Чат и RAG (открыты гостям): запросов за сутки (UTC) на весь сайт и за 10 минут с одного IP
# AI_CHAT_DAILY_LIMIT=2000
# AI_CHAT_IP_LIMIT=20
# Анализ изображения и PDF (вошедшие пользователи; сотрудники, кураторы и администраторы не ограничиваются)
# AI_HEAVY_DAILY_LIMIT=100
# AI_HEAVY_IP_LIMIT=10

# CDN для изображений (необязательно). Нужны DNS cdn.virtgal.ru → VPS и сервис `cdn` в docker-compose.prod.yml.
# Только https-домен без пути; пусто — картинки отдаёт само приложение.
CDN_BASE_URL=
# Где хранятся миниатюры (по умолчанию системная временная папка)
# THUMB_CACHE_DIR=/tmp/vg-thumbs

# Новый торговый движок (docs/AUCTION-DESIGN.md). Включайте после `npm run migrate` и решения владельца по правилам торгов:
# BIDDING_ENABLED=true
# Пока юрист не утвердил src/legal/*.md (status: approved), заявки на участие закрыты. Для проверки куратором до запуска:
# BIDDING_ALLOW_DRAFT_RULES=true

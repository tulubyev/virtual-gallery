# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=virtual_gallery_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_STRING=postgres://your-db-user:your-db-password@your-db-host:5432/virtual_gallery_db

# ===========================================
# AUTHENTICATION
# ===========================================
# Must be a long, random string (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ===========================================
# S3-COMPATIBLE STORAGE
# ===========================================
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=your-s3-region
S3_BUCKET_NAME=your-s3-bucket-name
S3_ENDPOINT=https://your-s3-endpoint

# ===========================================
# AI/ML SERVICE
# ===========================================
AI_CORE_URL=http://localhost:8001
